msgstr "De Buffer instellingen zijn succesvol opgeslagen!"

#. translators: %1$s is the name of the plugin, %2s and %3s is the name of the social network you want to share content with, %4s is the opening tag for the authorisation link, %5s is the closing tag of the link.
#: admin/class-evergreen_content_poster-admin.php:553
#, php-format
msgid ""
"%1s needs to be authorized with %2s before you can start sending posts to %3s. %4sClick here to "
"Authorize%5s."
msgstr ""
"%1s moet worden geautoriseerd met %2s voordat je kunt beginnen met het verzenden van berichten naar "
"%3s . %4sKlik hier om toegang te geven%5s."

#: admin/class-evergreen_content_poster-admin.php:571
#, php-format
msgid ""
"%s is now disconnected from %s. Please authorize again with %s before you can resume sending posts to "
"%s."
msgstr ""
"%s is nu losgekoppeld van %s. Geef opnieuw toestemming voor %s zodat we je berichten weer naar %s "
"kunnen sturen."

#: admin/class-evergreen_content_poster-admin.php:588
#, php-format
msgid ""
"%s token has expired. %s is now disconnected from %s. Please authorize again with %s before you can "
"resume sending posts to %s."
msgstr ""
"%s token is verlopen. %s is nu losgekoppeld van %s. Geef opnieuw toestemming voor %s voordat we weer "
"berichten naar %s kunnen sturen."

