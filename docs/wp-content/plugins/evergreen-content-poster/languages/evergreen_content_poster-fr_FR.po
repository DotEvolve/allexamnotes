msgid "Buffer Settings have been saved successfully!"
msgstr "Les paramètres du Buffer ont été enregistrés avec succès!"

#. translators: %1$s is the name of the plugin, %2s and %3s is the name of the social network you want to share content with, %4s is the opening tag for the authorisation link, %5s is the closing tag of the link.
#: admin/class-evergreen_content_poster-admin.php:553
#, php-format
msgid ""
"%1s needs to be authorized with %2s before you can start sending posts to "
"%3s. %4sClick here to Authorize%5s."
msgstr ""
"%1s doit être autorisé par %2s avant de pouvoir commencer à envoyer des "
"messages à %3s. %4sCliquez ici pour autoriser %5s."

#: admin/class-evergreen_content_poster-admin.php:571
#, php-format
msgid ""
"%s is now disconnected from %s. Please authorize again with %s before you "
"can resume sending posts to %s."
msgstr ""
"%s est maintenant déconnecté de %s. Veuillez autoriser à nouveau avec %s "
"afin que vous puissiez reprendre l’envoi de messages à %s."

#: admin/class-evergreen_content_poster-admin.php:588
#, php-format
msgid ""
"%s token has expired. %s is now disconnected from %s. Please authorize again "
"with %s before you can resume sending posts to %s."
msgstr ""
"Le jeton %s a expiré. %s est maintenant déconnecté de %s. Veuillez autoriser "
"à nouveau avec %s avant de pouvoir reprendre l’envoi de messages à %s."

