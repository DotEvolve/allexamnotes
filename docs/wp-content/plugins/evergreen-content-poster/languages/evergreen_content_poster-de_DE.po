#: admin/class-evergreen_content_poster-admin.php:213 admin/class-evergreen_content_poster-admin.php:329
msgid "Buffer Settings have been saved successfully!"
msgstr "Die Einstellungen bei Buffer wurden erfolgreich gespeichert!"

#. translators: %1$s is the name of the plugin, %2s and %3s is the name of the social network you want to share content with, %4s is the opening tag for the authorisation link, %5s is the closing tag of the link.
#: admin/class-evergreen_content_poster-admin.php:553
#, php-format
msgid ""
"%1s needs to be authorized with %2s before you can start sending posts to %3s. %4sClick here to "
"Authorize%5s."
msgstr ""
"%1s muss mit %2s autorisiert werden, bevor du anfangen kannst, Beiträge an %3s zu senden. %4sKlicke hier, "
"um zu autorisieren%5s."

#: admin/class-evergreen_content_poster-admin.php:571
#, php-format
msgid ""
"%s is now disconnected from %s. Please authorize again with %s before you can resume sending posts to %s."
msgstr ""
"%s ist jetzt von %s getrennt. Bitte autorisiere dich erneut bei %s, bevor du wieder Beiträge an %s senden "
"kannst."

#: admin/class-evergreen_content_poster-admin.php:588
#, php-format
msgid ""
"%s token has expired. %s is now disconnected from %s. Please authorize again with %s before you can resume "
"sending posts to %s."
msgstr ""
"Das Token %s ist abgelaufen. %s ist jetzt nicht mehr mit %s verbunden. Bitte autorisiere dich erneut bei "
"%s, bevor du wieder Beiträge an %s senden kannst."

